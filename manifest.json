{
  "manifest_version": 3,
  "name": "One Click Image Save",
  "version": "0.1.0",
  "description": "Save images from the context menu into a configured folder inside your Firefox downloads directory.",
  "permissions": [
    "contextMenus",
    "downloads",
    "storage",
    "notifications"
  ],
  "background": {
    "scripts": [
      "src/background.js"
    ]
  },
  "action": {
    "default_title": "Open One Click Image Save options",
    "default_icon": {
      "48": "icons/icon-48.svg",
      "96": "icons/icon-96.svg"
    }
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icons/icon-48.svg",
    "96": "icons/icon-96.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "one-click-image-save@example.com",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "strict_min_version": "109.0"
    }
  }
}
